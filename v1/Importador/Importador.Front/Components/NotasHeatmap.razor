@using Importador.Front.Models

@if (Resumo is null || Resumo.Count == 0)
{
    <div class="card card-muted center">Sem notas para exibir.</div>
}
else
{
    var bimestres = Resumo.Select(r => r.Bimestre).Distinct().OrderBy(x => x).ToList();
    var areas = Resumo.Select(r => r.Area).Distinct().OrderBy(x => x).ToList();

    <div class="card">
        <div class="card-title">Detalhamento de Notas por Área</div>
        <table class="tbl">
            <thead>
                <tr>
                    <th class="col-sm">Bim</th>
                    @foreach (var a in areas)
                    {
                        <th class="td-center">@a</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var b in bimestres)
                {
                    <tr>
                        <td class="td-center">Bim. @b</td>
                        @foreach (var a in areas)
                        {
                            var v = Resumo.FirstOrDefault(x => x.Bimestre == b && x.Area == a)?.Media;
                            <td class="td-center">@((v.HasValue ? v.Value.ToString("0.0") : "-"))</td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@code {
    [Parameter] public List<BimestreResumoDto> Resumo { get; set; } = new();
}
