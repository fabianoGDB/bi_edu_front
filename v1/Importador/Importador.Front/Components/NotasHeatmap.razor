@using Importador.Front.Models
@code {
    [Parameter] public NotasGrid Grid { get; set; } = new();
}

<div class="card" style="padding:0;">
    <div class="card-title" style="padding:16px">Detalhamento de Notas por Área</div>
    <table class="table">
        <thead>
            <tr>
                <th>Aluno</th>
                <th style="width:60px">Bim</th>
                @foreach (var a in Grid.Areas)
                {
                    <th>@a</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var linha in Grid.Linhas)
            {
                <tr>
                    <td>MARIA JOAQUINA</td>  @* rótulo do aluno opcional *@
                    <td>@linha.Rotulo</td>
                    @foreach (var v in linha.Valores)
                    {
                        <td>
                            @if (v.HasValue)
                            {
                                @v.Value.ToString("0.#")
                            }
                            else
                            {
                                <span>-</span>
                            }
                        </td>
                    }
                </tr>
            }
        </tbody>
    </table>
</div>
