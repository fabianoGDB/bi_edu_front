@using Importador.Front.Models

<div class="card">
    <div class="with-icon" style="justify-content:space-between;">
        <div class="with-icon">
            <span class="material-symbols-outlined">chat</span>
            <div class="card-title">Observações Pedagógicas</div>
        </div>

        <div class="card-actions">
            <label class="filebtn" title="Importar Observações (CSV)">
                <span class="material-symbols-outlined">upload</span>
                Importar Observações
                <InputFile OnChange="OnCsvSelected" accept=".csv" />
            </label>

            <button class="btn" @onclick="ExportBase" title="Exportar Planilha Base">
                <span class="material-symbols-outlined">download</span>
                Exportar Planilha Base
            </button>
        </div>
    </div>

    @if (Items is null || Items.Count == 0)
    {
        <div class="card-muted center" style="padding:14px;">Nenhuma observação.</div>
    }
    else
    {
        <div style="display:grid;gap:18px;margin-top:8px;">
            @foreach (var it in Items)
            {
                <div style="display:grid;grid-template-columns:1fr auto auto;gap:12px;border-bottom:1px solid var(--line);padding-bottom:14px;">
                    <div>
                        <div class="sub" style="font-weight:700">@it.Codigo</div>
                        <div>@it.Texto</div>
                    </div>
                    <div class="sub"><span class="material-symbols-outlined">person</span> @it.Autor</div>
                    <div class="sub"><span class="material-symbols-outlined">calendar_month</span> @it.Data?.ToString("dd/MM/yyyy")</div>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<ObservacaoItem> Items { get; set; } = new();
    [Parameter] public EventCallback<IBrowserFile> ImportCsvRequested { get; set; }
    [Parameter] public EventCallback ExportBaseRequested { get; set; }

    private async Task OnCsvSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file != null && ImportCsvRequested.HasDelegate)
        {
            await ImportCsvRequested.InvokeAsync(file);
        }
    }

    private async Task ExportBase()
    {
        if (ExportBaseRequested.HasDelegate)
            await ExportBaseRequested.InvokeAsync();
    }
}
