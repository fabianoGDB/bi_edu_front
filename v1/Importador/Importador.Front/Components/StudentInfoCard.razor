@using Importador.Front.Models
@inherits ComponentBase

<div class="card" style="display:grid;grid-template-columns:180px 1fr;gap:16px;">
    <div style="background:#0f1316;border-radius:12px;overflow:hidden;">
        @if (!string.IsNullOrWhiteSpace(Aluno?.FotoUrl))
        {
            <img src="@Aluno!.FotoUrl" alt="@Aluno!.Nome" style="width:100%;height:180px;object-fit:cover" />
        }
        else
        {
            <div style="height:180px;display:flex;align-items:center;justify-content:center;color:#7f8b94">
                <span class="material-symbols-outlined">account_box</span>
            </div>
        }
        <div style="padding:10px;text-align:center">
            <div style="font-weight:800">@Aluno?.Nome</div>
            <div class="sub">Matrícula: @Aluno?.Matricula</div>
        </div>
    </div>

    <div>
        <div class="card-title">Situação geral</div>

        <div class="council-state">
            <div class="state-row">
                <span class="material-symbols-outlined">percent</span>
                <div>
                    <div class="state-title">Frequência</div>
                    <div class="sub">@Aluno?.Frequencia?.ToString("0.##") ?? "-"%</div>
                </div>
            </div>

            <div class="state-row" style="margin-top:10px">
                <span class="material-symbols-outlined">verified</span>
                <div>
                    <div class="state-title">Situação</div>
                    <div class="sub">@((Aluno?.Situacao ?? "-"))</div>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [Parameter] public AlunoDetalhe? Aluno { get; set; }
}
