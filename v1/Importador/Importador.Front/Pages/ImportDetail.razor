@page "/imports/{Id:guid}"
@using Importador.Front.Models
@using Importador.Front.Services
@inject IImportsApi Api
@inject NavigationManager Nav

<h2 class="h1">Detalhe do Import</h2>
<p class="sub">@Id</p>

<div class="card">
    @if (_status is null)
    {
        <div class="sub">Carregando…</div>
    }
    else
    {
        <div style="display:flex;gap:8px;flex-wrap:wrap;margin-bottom:12px">
            <NavLink class="btn" href=@($"/imports/{Id}/students")>Ver Alunos</NavLink>
            <button class="btn" @onclick="Processar">Reprocessar</button>
        </div>

        <table class="table">
            <thead>
                <tr>
                    <th>Etapa</th>
                    <th>Status</th>
                    <th>Processados</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in _status.Stages)
                {
                    <tr>
                        <td>@s.Name</td>
                        <td>
                            @switch (s.Status)
                            {
                                case 0:
                                    <span class="badge badge-info">Aguardando</span>
                                    ; break;
                                case 1:

                                    <span class="badge badge-warn">Processando</span>
                                    ; break;
                                case 2:

                                    <span class="badge badge-ok">Concluída</span>
                                    ; break;
                                case 3:

                                    <span class="badge badge-err">Erro</span>
                                    ; break;
                                default:

                                    <span class="badge">?</span>
                                    ; break;
                            }
                        </td>
                        <td>@s.ProcessedRows</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>

@code {
    [Parameter] public Guid Id { get; set; }
    ImportStatus? _status;

    protected override async Task OnInitializedAsync()
    {
        await LoadStatus();
    }

    async Task LoadStatus()
    {
        _status = await Api.GetImportStatusAsync(Id);
        StateHasChanged();
        if (_status?.Stages.Any(s => s.Status == 1) == true)
        {
            // repete enquanto houver processando
            await Task.Delay(3500);
            await LoadStatus();
        }
    }

    async Task Processar()
    {
        await Api.ProcessAsync(Id);
        await LoadStatus();
    }
}
