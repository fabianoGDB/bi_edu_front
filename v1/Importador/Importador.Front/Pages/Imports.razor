@page "/imports"
@using Importador.Front.Models
@using Importador.Front.Services
@inject IImportsApi Api
@inject NavigationManager Nav

<h2 class="h1">Imports</h2>

<div class="list-card">
    <div class="list-header">
        <div class="title">
            <span class="material-symbols-outlined">dataset</span>
            Lista de Imports
        </div>
    </div>

    <div class="list-toolbar">
        <input class="input" placeholder="Buscar por arquivo..."
               @bind="_q" @bind:event="oninput" />
        <button class="btn" @onclick="LoadAsync">
            <span class="material-symbols-outlined">refresh</span> Atualizar
        </button>
    </div>

    <table class="tbl">
        <thead>
            <tr>
                <th>Arquivo</th>
                <th class="td-center col-n">Alunos</th>
                <th class="col-md">Criado (UTC)</th>
                <th>Status</th>
                <th class="td-center col-md">Ações</th>
            </tr>
        </thead>
        <tbody>
            @if (_items is null)
            {
                <tr><td colspan="5" class="sub" style="padding:16px">Carregando…</td></tr>
            }
            else if (!_items.Any())
            {
                <tr><td colspan="5" class="sub" style="padding:16px">Nenhum import.</td></tr>
            }
            else
            {
                @foreach (var it in _view)
                {
                    <tr>
                        <td>@it.OriginalFileName</td>
                        <td class="td-center">@it.Alunos</td>
                        <td>@it.CreatedAtUtc.ToString("yyyy-MM-dd HH:mm:ss\\Z")</td>
                        <td>
                            <span class="badge @(StatusCss(it.Status))">
                                @StatusText(it.Status)
                            </span>
                        </td>
                        <td class="td-center">

                            <button class="btn btn-ghost" title="Alunos"
                                    @onclick="() => NavigateToStudents(it.Id)">
                                <span class="material-symbols-outlined">visibility</span>
                                <span>Alunos</span>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <div class="list-footer">
        <span class="sub">Mostrando @(_view?.Count ?? 0) import(s)</span>
    </div>
</div>

@code {
    List<ImportListItem>? _items;
    List<ImportListItem> _view = new();
    string? _q;

    protected override async Task OnInitializedAsync()
    {
        await LoadAsync();
    }

    async Task LoadAsync()
    {
        try
        {
            _items = await Api.GetImportsAsync() ?? new();
            ApplyFilter();
        }
        catch (Exception ex)
        {
            Console.Error.WriteLine($"Erro ao carregar imports: {ex.Message}");
            _items = new();
        }
    }

    void ApplyFilter()
    {
        if (string.IsNullOrWhiteSpace(_q))
        {
            _view = _items ?? new();
        }
        else
        {
            var q = _q.Trim().ToUpperInvariant();
            _view = _items!
                .Where(x => x.OriginalFileName?.ToUpperInvariant().Contains(q) ?? false)
                .ToList();
        }
    }

    static string StatusText(int status) => status switch
    {
        2 => "Finalizado",
        1 => "Processando",
        3 => "Erro",
        _ => "Pendente"
    };

    static string StatusCss(int status) => status switch
    {
        2 => "badge-ok",
        1 => "badge-info",
        3 => "badge-err",
        _ => "badge-warn"
    };
    public void NavigateToStudents(Guid id)
    {
        Nav.NavigateTo($"/imports/{id}/students");
    }
}
