@page "/students/{AlunoId:int}"
@using Importador.Front.Models
@using Importador.Front.Components

<h1 class="h1">Conselho do Aluno</h1>
<p class="sub">Aluno @AlunoId</p>

<!-- Só o Heatmap por enquanto -->
<div class="section">
    <NotasHeatmap Resumo="_resumo"/>
</div>

@code {
    [Parameter] public int AlunoId { get; set; }

    // Mock no formato da opção B: (Area, Bimestre, Media)
    private List<BimestreResumoDto> _resumo = new();

    protected override void OnParametersSet()
    {
        // Dados falsos para visualizar o heatmap
        _resumo = new()
        {
            // Matemática
            new() { Area = "Matemática", Bimestre = 1, Media = 6.5m },
            new() { Area = "Matemática", Bimestre = 2, Media = 7.2m },
            new() { Area = "Matemática", Bimestre = 3, Media = 7.8m },
            new() { Area = "Matemática", Bimestre = 4, Media = 6.9m },

            // Ciências da Natureza
            new() { Area = "Ciências", Bimestre = 1, Media = 7.1m },
            new() { Area = "Ciências", Bimestre = 2, Media = 6.8m },
            new() { Area = "Ciências", Bimestre = 3, Media = 7.3m },
            new() { Area = "Ciências", Bimestre = 4, Media = 8.1m },

            // Linguagens
            new() { Area = "Linguagens", Bimestre = 1, Media = 8.0m },
            new() { Area = "Linguagens", Bimestre = 2, Media = 7.7m },
            new() { Area = "Linguagens", Bimestre = 3, Media = 8.6m },
            new() { Area = "Linguagens", Bimestre = 4, Media = 8.3m },

            // Disciplinas Técnicas
            new() { Area = "D. Técnicas", Bimestre = 1, Media = 7.4m },
            new() { Area = "D. Técnicas", Bimestre = 2, Media = 7.1m },
            new() { Area = "D. Técnicas", Bimestre = 3, Media = 7.9m },
            new() { Area = "D. Técnicas", Bimestre = 4, Media = 8.0m },
        };
    }
}
