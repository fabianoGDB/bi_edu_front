@page "/students/{AlunoId:int}"
@using Importador.Front.Components
@inject NavigationManager Nav

@code {
    [Parameter] public int AlunoId { get; set; }
    Guid? _importId;

    protected override void OnParametersSet()
    {
        var u = new Uri(Nav.Uri);
        var qs = System.Web.HttpUtility.ParseQueryString(u.Query);
        if (Guid.TryParse(qs.Get("importId"), out var imp)) _importId = imp;
    }
}

<h2 class="h1">Conselho do Aluno</h2>
<p class="sub">Aluno @AlunoId @if (_importId is not null){
<text>— Import @_importId</text>
}
</p>

<!-- Apenas instancia o componente que já consome a API -->
<StudentCouncil AlunoId="AlunoId" ImportId="_importId" />
