@page "/students/{id:int}"
@using Microsoft.AspNetCore.Components
@attribute [SupplyParameterFromQuery(Name = "importId")]
@inject NavigationManager Nav

<h1 class="page-title">Detalhes do Aluno</h1>

<a class="muted" style="display:inline-flex;align-items:center;gap:6px;margin-bottom:14px;cursor:pointer;"
   @onclick="() => Nav.NavigateTo("/imports")">
    <span class="material-symbols-outlined">arrow_back</span> Voltar para Lista
</a>

<div class="student-grid">
    @* ================== CARD: INFO (foto, nome, situação, frequência) ================== *@
    <div class="card">
        <div class="list-header">
            <div class="title">
                <span class="material-symbols-outlined">badge</span>
                Informações do Aluno
            </div>
        </div>

        <ErrorBoundary>
            <ChildContent>
                <StudentInfoCard StudentId="@id" ImportId="@(importId)"/>
            </ChildContent>
            <ErrorContent>
                @* erro/sem dados → card permanece, apenas um espaço vazio *@
                <div style="height:180px"></div>
            </ErrorContent>
        </ErrorBoundary>
    </div>

    @* ================== CARD: HEATMAP DE NOTAS ================== *@
    <div class="card student-span-2">
        <div class="list-header">
            <div class="title">
                <span class="material-symbols-outlined">grid_on</span>
                Detalhamento de Notas por Área
            </div>
        </div>

        <ErrorBoundary>
            <ChildContent>
                <NotasHeatmap StudentId="@id" ImportId="@(importId)"/>
            </ChildContent>
            <ErrorContent>
                <div style="height:260px"></div>
            </ErrorContent>
        </ErrorBoundary>
    </div>

    @* ================== CARD: OBSERVAÇÕES ================== *@
    <div class="card student-span-2">
        <div class="list-header">
            <div class="title">
                <span class="material-symbols-outlined">styler</span>
                Observações Pedagógicas
            </div>
            <div class="card-actions">
                @* botões do próprio componente podem cuidar da importação/exportação *@
            </div>
        </div>

        <ErrorBoundary>
            <ChildContent>
                <ObservacoesList StudentId="@id" ImportId="@(importId)"/>
            </ChildContent>
            <ErrorContent>
                <div style="height:180px"></div>
            </ErrorContent>
        </ErrorBoundary>
    </div>
</div>

@code {
    [Parameter] public int id { get; set; }
    [Parameter] public int? importId { get; set; }
}
