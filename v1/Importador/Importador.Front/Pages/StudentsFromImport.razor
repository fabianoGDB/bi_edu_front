@page "/imports/{Id:guid}/students"
@using Importador.Front.Models
@using System.Net.Http.Headers
@using Importador.Front.Services
@inject IImportsApi Api
@inject NavigationManager Nav

<h2 class="h1">Alunos da Planilha</h2>
<p class="sub">Import @Id</p>

<div class="list-card">

    <!-- Cabeçalho do card -->
    <div class="list-header">
        <div class="title">
            <span class="material-symbols-outlined">group</span>
            <span>Lista de Alunos</span>
        </div>

        <div style="display:flex; gap:10px; align-items:center;">
            <!-- Exportar CSV -->
            <button class="btn" title="Exportar Matrícula/Foto" @onclick="ExportCsv">
                <span class="material-symbols-outlined">download</span>
                <span>Exportar Matrícula/Foto</span>
            </button>

            <!-- Importar CSV -->
            <label class="filebtn" title="Importar Matrícula/Foto">
                <span class="material-symbols-outlined">upload</span>
                <span>Importar Matrícula/Foto</span>
                <InputFile accept=".csv" OnChange="OnCsvSelected" />
            </label>
        </div>
    </div>

    <!-- Toolbar (busca) -->
    <div class="list-toolbar">
        <input class="input" placeholder="Buscar por nome ou matrícula..."
        @bind="_q" @bind:event="oninput" />
    </div>

    <!-- Tabela -->
    <table class="tbl">
        <thead>
            <tr>
                <th class="col-n">#</th>
                <th>Nome</th>
                <th class="col-md">Matrícula</th>
                <th class="col-sm td-center">Ações</th>
            </tr>
        </thead>

        <tbody>
            @if (!string.IsNullOrWhiteSpace(_err))
            {
                <tr>
                    <td colspan="4" class="sub" style="padding:18px;">
                        @(_err)
                    </td>
                </tr>
            }
            else if (_view is null)
            {
                <tr>
                    <td colspan="4" class="sub" style="padding:18px;">Carregando…</td>
                </tr>
            }
            else if (_view.Count == 0)
            {
                <tr>
                    <td colspan="4" class="sub" style="padding:18px;">Nenhum aluno encontrado.</td>
                </tr>
            }
            else
            {
                @foreach (var (aluno, idx) in _view.Select((a, i) => (a, i + 1)))
                {
                    <tr>
                        <td class="col-n">@idx</td>
                        <td>@aluno.Nome</td>
                        <td class="col-md">@aluno.Matricula</td>
                        <td class="td-center col-sm">
                            <button class="btn btn-ghost" title="Ver"
                            @onclick="() => GoToAluno(aluno.Id)">
                                <span class="material-symbols-outlined">visibility</span>
                                <span>Ver</span>
                            </button>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>

    <!-- Rodapé -->
    <div class="list-footer">
        <div>@($"{_view?.Count ?? 0} aluno(s) exibido(s)")</div>
        <div>Filtro: @_q</div>
    </div>
</div>

@code {
    [Parameter] public Guid Id { get; set; }

    List<AlunoListItem>? _all;
    List<AlunoListItem>? _view;
    string? _q;
    string? _err;


    protected override async Task OnParametersSetAsync()
    {
        await LoadAsync();
        ApplyFilter();
    }

    async Task LoadAsync()
    {
        _err = null;
        _all = _view = null;

        try
        {
            _all = await Api.GetAlunosFromImportAsync(Id) ?? new();
            _view = _all;
        }
        catch (Exception ex)
        {
            // O service já tenta identificar quando vem HTML; exibimos “limpo” aqui
            _err = $"Erro ao carregar alunos: {ex.Message}";
            _all = _view = new();
        }
        StateHasChanged();
    }

    void ApplyFilter()
    {
        var q = _q?.Trim().ToUpperInvariant();
        if (string.IsNullOrEmpty(q)) { _view = _all ?? new(); return; }

        _view = (_all ?? new()).Where(x =>
            (x.Nome?.ToUpperInvariant().Contains(q) ?? false) ||
            (x.Matricula?.ToUpperInvariant().Contains(q) ?? false)
        ).ToList();
    }

    // Exportar CSV (Matrícula/Foto)
    void ExportCsv()
        => Nav.NavigateTo($"/api/imports/{Id}/alunos/export-info", forceLoad: true);

    // Abrir detalhes do aluno
    void GoToAluno(int alunoId)
        => Nav.NavigateTo($"/students/{alunoId}?importId={Id}");

    // Importar CSV (Matrícula/Foto)
    async Task OnCsvSelected(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file is null) return;

        try
        {
            using var stream = file.OpenReadStream(maxAllowedSize: 20 * 1024 * 1024);
            (bool ok, string? msg) = await Api.ImportInfoCsvAsync(Id, stream, file.Name);

            if (!ok)
            {
                _err = $"Falha ao importar CSV: {msg}";
            }
            else
            {
                _err = null;
                await LoadAsync();   // recarrega a lista (pode ter atualizado matrículas/fotos)
            }
        }
        catch (Exception ex)
        {
            _err = $"Erro ao importar CSV: {ex.Message}";
        }
        StateHasChanged();
    }
}
